---
import MainLayout from '../layouts/MainLayout.astro';
import Header from '../components/layout/Header.astro';
---
<MainLayout title="Iniciar sesión | Huellas">
  <main class="min-h-screen bg-[#FFF8ED] px-6 pt-28"><Header /><div class="mx-auto grid max-w-5xl items-center gap-12 py-12 lg:grid-cols-2"><div><p class="font-bold text-refuge-800">Panel del refugio</p><h1 class="mt-3 font-display text-5xl font-black leading-tight text-refuge-950">Bienvenido de vuelta.</h1><p class="mt-5 max-w-md leading-7 text-refuge-950/60">Administra con cuidado cada historia y ayúdanos a encontrar el hogar ideal.</p><img src="/images/cat-card.svg" alt="Gato ilustrado" class="mt-8 max-w-xs" /></div><form id="login-form" class="rounded-3xl bg-white p-7 shadow-soft sm:p-10"><h2 class="font-display text-3xl font-bold text-refuge-950">Iniciar sesión</h2><div class="mt-7 space-y-5"><label class="block space-y-2 text-sm font-bold">Usuario<input class="field" name="usuario" maxlength="15" required autocomplete="username" /></label><label class="block space-y-2 text-sm font-bold">Contraseña<input class="field" name="contrasena" maxlength="60" required type="password" autocomplete="current-password" /></label></div><p data-form-message class="mt-5 hidden rounded-xl px-4 py-3 text-sm"></p><button class="button-primary mt-6 w-full" type="submit">Entrar al panel</button></form></div></main>
  <script>
    import { loginSchema } from '../schemas/auth.schema';
    import { login } from '../lib/auth';
    const form = document.querySelector<HTMLFormElement>('#login-form');
    const message = document.querySelector<HTMLElement>('[data-form-message]');
    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      const parsed = loginSchema.safeParse(data);
      if (!parsed.success) { message!.textContent = parsed.error.issues[0].message; message!.className = 'mt-5 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700'; return; }
      try { await login(parsed.data.usuario, parsed.data.contrasena); window.location.href = '/animals'; }
      catch (error) { message!.textContent = error instanceof Error ? error.message : 'No fue posible iniciar sesión'; message!.className = 'mt-5 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700'; }
    });
  </script>
</MainLayout>



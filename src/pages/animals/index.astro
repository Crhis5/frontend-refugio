---
import MainLayout from '../../layouts/MainLayout.astro';
import Header from '../../components/layout/Header.astro';
import AnimalCard from '../../components/animals/AnimalCard.astro';
const animals = [];
---
<MainLayout title="Animales | Huellas" protectedPage><Header /><main class="min-h-screen bg-[#FFF8ED] px-6 pb-16 pt-28 lg:px-14"><div class="mx-auto max-w-7xl"><div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end"><div><p class="font-bold text-refuge-800">Panel de administración</p><h1 class="mt-2 font-display text-5xl font-black text-refuge-950">Nuestros animales</h1></div><a class="button-primary" href="/animals/new">+ Registrar animal</a></div><form id="filters" class="mt-10 grid gap-3 rounded-3xl bg-white p-5 shadow-sm md:grid-cols-5"><input class="field" name="nombre" placeholder="Nombre" /><input class="field" name="raza" placeholder="Raza" /><select class="field" name="sexo"><option value="">Todos los sexos</option><option>Hembra</option><option>Macho</option></select><select class="field" name="tipoAnimal"><option value="">Todos los tipos</option><option>Perro</option><option>Gato</option></select><button class="button-primary" type="submit">Filtrar</button></form><p data-list-message class="mt-6 hidden rounded-xl px-4 py-3 text-sm"></p><div id="animal-grid" class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{animals.map((animal) => <AnimalCard animal={animal} />)}</div><div id="empty-state" class="mt-12 hidden rounded-3xl bg-white p-12 text-center shadow-sm"><p class="font-display text-3xl font-bold">Aún no hay coincidencias</p><p class="mt-2 text-refuge-950/60">Prueba con otros filtros.</p></div></div></main></MainLayout>
<script>
  import { listAnimals } from '../../lib/api';
  import { clearToken, getToken } from '../../lib/storage';
  const grid = document.querySelector<HTMLElement>('#animal-grid'); const empty = document.querySelector<HTMLElement>('#empty-state'); const message = document.querySelector<HTMLElement>('[data-list-message]'); const form = document.querySelector<HTMLFormElement>('#filters');
  if (!getToken()) window.location.href = '/login';
  const render = async (filters: Record<string, string> = {}) => { try { const animals = await listAnimals(filters); grid!.innerHTML = animals.map((a) => `<article class="group overflow-hidden rounded-3xl bg-white shadow-soft"><div class="relative h-32 overflow-hidden bg-${a.tipoAnimal === 'Perro' ? 'refuge-800' : 'sun-500'} p-5"><span class="rounded-full bg-white/20 px-3 py-1 text-xs font-bold text-white">${a.tipoAnimal}</span><span class="absolute -bottom-8 -right-2 text-8xl">${a.tipoAnimal === 'Perro' ? '🐶' : '🐱'}</span></div><div class="space-y-2 p-5"><div class="flex justify-between"><h3 class="font-display text-2xl font-bold">${a.nombre}</h3><span class="text-sm opacity-60">${a.edad} años</span></div><p class="text-sm opacity-65">${a.raza} · ${a.sexo}</p><p class="text-xs opacity-45">Ingreso: ${a.fechaIngreso}</p><a href="/animals/edit?id=${a.identificador}" class="mt-3 inline-block text-sm font-bold text-refuge-800">Editar animal →</a></div></article>`).join(''); empty!.classList.toggle('hidden', animals.length > 0); } catch (error) { if (error instanceof Error && error.message.includes('Token')) { clearToken(); window.location.href = '/login'; return; } message!.textContent = error instanceof Error ? error.message : 'No se pudo cargar la lista'; message!.className = 'mt-6 rounded-xl bg-red-50 px-4 py-3 text-sm text-red-700'; } };
  form?.addEventListener('submit', (event) => { event.preventDefault(); render(Object.fromEntries(new FormData(form)) as Record<string, string>); }); render();
</script>



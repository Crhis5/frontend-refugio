---
import type { Animal } from '../../types/animal.types';
const { animal } = Astro.props as { animal: Animal };
const isDog = animal.tipoAnimal === 'Perro';
---
<article class="group overflow-hidden rounded-3xl bg-white shadow-soft transition hover:-translate-y-1">
  <div class:list={["relative h-32 overflow-hidden p-5", isDog ? 'bg-refuge-800' : 'bg-sun-500']}>
    <span class="rounded-full bg-white/20 px-3 py-1 text-xs font-bold text-white">{animal.tipoAnimal}</span>
    <span class="absolute -bottom-8 -right-2 text-8xl opacity-90">{isDog ? '🐶' : '🐱'}</span>
  </div>
  <div class="space-y-2 p-5">
    <div class="flex items-start justify-between gap-3"><h3 class="font-display text-2xl font-bold text-refuge-950">{animal.nombre}</h3><span class="text-sm text-refuge-950/60">{animal.edad} años</span></div>
    <p class="text-sm text-refuge-950/65">{animal.raza} · {animal.sexo}</p>
    <p class="text-xs text-refuge-950/45">Ingreso: {animal.fechaIngreso}</p>
    <a href={`/animals/edit?id=${animal.identificador}`} class="mt-3 inline-block text-sm font-bold text-refuge-800 hover:text-refuge-950">Editar animal →</a>
  </div>
</article>


